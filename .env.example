# Copy this file to .env and fill in real values before using LIVE mode.

# "mock" runs a simulated trading desk (safe, default, no real money moves).
# "live" sends real requests to TRADING_DESK_BASE_URL — only switch this once
# TradingDeskClient's request/response mapping (src/tradingDeskClient.js) has
# been updated to match your actual trading desk API's real contract.
TRADING_DESK_MODE=mock

# --- Only used when TRADING_DESK_MODE=live ---
TRADING_DESK_BASE_URL=https://example-trading-desk.internal/api
TRADING_DESK_API_KEY=replace-me
TRADING_DESK_ACCOUNT_ID=replace-me

# Port the app listens on
PORT=3000

# Optional: enable email notifications on order completion (see src/notifier.js).
# Leave blank to use console/SSE notifications only.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
